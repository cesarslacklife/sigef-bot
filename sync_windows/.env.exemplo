# Copie este arquivo para ".env" (sem o .exemplo) e preencha.
# NUNCA suba este arquivo pra lugar nenhum com a senha preenchida.

# Conexão com o Postgres da VPS (libere a porta 5432 só pro seu IP no firewall da Hetzner)
PG_DSN=postgresql://sigef_bot:SUA_SENHA@116.203.159.210:5432/sigef

# UF a sincronizar
SYNC_UF=RJ

# URL do ZIP (confirme na página Download de Shapefiles do Acervo Fundiário)
SYNC_URL_ZIP=https://certificacao.incra.gov.br/csv_shp/zip/Sigef%20Privado_RJ.zip

# Webhook do n8n que manda aviso no seu WhatsApp (workflow admin_notify)
WEBHOOK_NOTIFY=https://SEU_N8N/webhook/sigef-admin

# Trava de segurança: aborta se vier menos que isso de parcelas
SYNC_MIN_FEATURES=1000
