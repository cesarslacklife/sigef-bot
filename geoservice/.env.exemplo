# Copie para ".env" dentro da pasta geoservice/ e preencha NA VPS.
# ⚠️ As credenciais gov.br ficam SÓ aqui. Não compartilhe com ninguém
#    (nem comigo, o Craudio — eu trabalho com placeholder mesmo 😄).

# --- Banco (espelho PostGIS) ---
PG_DSN=postgresql://sigef_bot:SUA_SENHA@postgres:5432/sigef

# --- Redis (estado da conversa; db 3 pra não misturar com a Dra. Malu) ---
REDIS_URL=redis://redis:6379/3

# --- Como a Evolution API enxerga este serviço na rede docker ---
BASE_URL=http://sigef-geoservice:8000

# --- Entrega 2: documentos oficiais do SIGEF ---
# 1 = liga (precisa das credenciais abaixo) | 0 = só arquivos locais
SIGEF_OFICIAL=1
GOVBR_CPF=00000000000
GOVBR_SENHA=coloque_aqui_somente_na_vps

# --- Webhook do n8n p/ avisos de admin (captcha, falhas) ---
WEBHOOK_NOTIFY=https://SEU_N8N/webhook/sigef-admin

# --- Diversos ---
UTM_FUSO_PADRAO=23
TTL_ESTADO=1800
FILES_DIR=/data/files
PW_DIR=/data/pw
